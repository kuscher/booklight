<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used for two things, each only after the user's own act. Search suggestions, once they are turned
         on (first-run card or settings): the typed text then goes to the chosen search engine. And a
         flight's times, once the user has put a key of their own for the flight service into the
         Booklight window: a typed flight number then goes to that service with the key. With neither,
         nothing typed leaves the device until a web row is chosen, which hands the text to the browser. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Uninstall" on an app's row. Granted at install, no prompt; Android shows its own
         "Do you want to uninstall this app?" every time. Without it the request is ignored silently. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Timers, alarms and reminders are handed to the Clock app. Granted at install, no prompt. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Brightness. Does nothing until the user switches on "Modify system settings" for Booklight in
         Settings; the brightness row says so and opens that page. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- No runtime permissions, no accessibility service. -->

    <!-- The app list: launchable apps only (no QUERY_ALL_PACKAGES), and the Settings app for its pages. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.settings" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Which app is the home screen: a start from there (its icon) opens the Booklight window, any other start the panel. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Keyboard and trackpad are enough: laptops without a touchscreen can install it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Google Play offers Booklight to desktop Android devices (Googlebooks) only, like Alex's other apps:
         it is a keyboard launcher, and the system's custom shortcuts exist there. Android doesn't enforce
         this at install time, so the APK from GitHub still installs anywhere. Narrow first: widening later
         strands nobody, narrowing later would. -->
    <uses-feature android:name="android.hardware.type.pc" android:required="true" />

    <application
        android:name=".BooklightApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Booklight">

        <!-- The panel. It IS the launcher activity: the Googlebook's custom keyboard shortcuts start an
             app's launcher activity. Started by a shortcut it is the panel; started from the app's icon it
             hands over to the Booklight window. -->
        <activity
            android:name=".overlay.OverlayActivity"
            android:exported="true"
            android:theme="@style/Theme.Booklight.Overlay"
            android:launchMode="singleInstance"
            android:taskAffinity="io.github.kuscher.booklight.overlay"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateVisible|adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the user choose Booklight as the digital assistant in Settings, so the assistant key opens the panel.
                 Booklight never asks for this; one row in its window says it is possible. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "Booklight" in the text-selection menu and in the share sheet for plain text: the panel opens with
                 the text as a chip, and the rows are what to do with it. The text stays on the device. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- A search pill for the home screen: a click opens the panel. -->
        <receiver android:name=".entry.SearchWidget" android:exported="false" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_search" />
        </receiver>

        <!-- A Quick Settings tile that opens the panel. The system binds it; nothing else can. -->
        <service
            android:name=".entry.PanelTile"
            android:exported="true"
            android:icon="@drawable/ic_booklight"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The Booklight window: what it is, how to give it a key, every setting, the user's own commands.
             An ordinary window. The app's icon opens it (the panel hands over when it was started from the
             launcher, the taskbar or the Apps list); so does "Booklight settings" in the panel. -->
        <activity
            android:name=".window.MainActivity"
            android:exported="false"
            android:taskAffinity="io.github.kuscher.booklight.window"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:launchMode="singleTask">
            <!-- The narrowest it is laid out for: a navigation bar and one column. -->
            <layout android:minWidth="400dp" android:minHeight="480dp" />
        </activity>

        <!-- The pinned window: a picture-in-picture window, the one kind the system keeps on top without ever giving
             it the keyboard. One at a time. The smallest size named here is the size the system opens it at. -->
        <activity
            android:name=".pin.PinActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Booklight.Pin"
            android:taskAffinity="io.github.kuscher.booklight.pin"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode">
            <layout android:minWidth="280dp" android:minHeight="118dp" />
        </activity>
        <!-- Asks once where notes go (the system's folder picker). No screen of its own. -->
        <activity
            android:name=".entry.PickFolderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Booklight.Overlay" />

        <!-- Hands a picture Booklight made (a QR code) to the clipboard or the share sheet. Its own cache only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
