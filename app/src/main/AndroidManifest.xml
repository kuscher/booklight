<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used for search suggestions only, and only after the user turns them on (first-run card or
         settings): the typed text then goes to the chosen search engine. With suggestions off, nothing
         typed leaves the device until a web row is chosen, which hands the text to the browser. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Uninstall" on an app's row. Granted at install, no prompt; Android shows its own
         "Do you want to uninstall this app?" every time. Without it the request is ignored silently. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Timers, alarms and reminders are handed to the Clock app. Granted at install, no prompt. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Brightness. Does nothing until the user switches on "Modify system settings" for Booklight in
         Settings; the brightness row says so and opens that page. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- No runtime permissions, no accessibility service, nothing that runs in the background. -->

    <!-- The app list: launchable apps only (no QUERY_ALL_PACKAGES), and the Settings app for its pages. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.settings" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Keyboard and trackpad are enough: laptops without a touchscreen can install it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Google Play offers Booklight to desktop Android devices (Googlebooks) only, like Alex's other apps:
         it is a keyboard launcher, and the system's custom shortcuts exist there. Android doesn't enforce
         this at install time, so the APK from GitHub still installs anywhere. Narrow first: widening later
         strands nobody, narrowing later would. -->
    <uses-feature android:name="android.hardware.type.pc" android:required="true" />

    <application
        android:name=".BooklightApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Booklight">

        <!-- The panel. It IS the launcher activity: the Googlebook's custom keyboard shortcuts start an
             app's launcher activity, so opening Booklight (shortcut, taskbar, Apps list) shows the panel. -->
        <activity
            android:name=".overlay.OverlayActivity"
            android:exported="true"
            android:theme="@style/Theme.Booklight.Overlay"
            android:launchMode="singleInstance"
            android:taskAffinity="io.github.kuscher.booklight.overlay"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateVisible|adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings and first-run help: an ordinary window, opened from the panel. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:taskAffinity="io.github.kuscher.booklight.settings"
            android:launchMode="singleTask" />

        <!-- Asks once where notes go (the system's folder picker). No screen of its own. -->
        <activity
            android:name=".entry.PickFolderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Booklight.Overlay" />

        <!-- Hands a picture Booklight made (a QR code) to the clipboard or the share sheet. Its own cache only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>

        <!-- adb-only test hooks: the shell holds DUMP, apps don't. -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.kuscher.booklight.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
