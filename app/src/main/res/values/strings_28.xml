    <string name="cmd_paste_no_app">Read into the form. %1$s is not on this device: choose the app.</string>
    <string name="cmd_paste_not">This is neither an “am start” line nor an intent: address.</string>
    <string name="cmd_paste_quote">A quote is not closed.</string>
