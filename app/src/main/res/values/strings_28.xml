    <string name="win_why_address_empty">It needs an address.</string>
    <string name="win_link_app">An app’s own address works too: spotify:search:{argument} searches in Spotify.</string>
    <!-- The footer, when nothing answers a link's address or what another app was asked. -->
    <string name="failed_open">Nothing on this device opens that</string>
