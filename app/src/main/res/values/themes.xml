<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Booklight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The pinned window: no start-up picture, and what the system shows of it before its own first frame is
         the colour of its ground, not white. -->
    <style name="Theme.Booklight.Pin">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/pin_ground</item>
        <item name="android:colorBackground">@color/pin_ground</item>
    </style>

    <!-- The panel's window: see-through, no title, no start-up picture, no system animation
         (the panel animates itself, so it can appear in the same frame as the key press). -->
    <style name="Theme.Booklight.Overlay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <!-- The shadow around the panel is the system's own, cast by the window. Its strength is chosen per setting,
             through the shadow's colours (OverlayActivity); these two only take the theme's own ceiling away. -->
        <item name="android:ambientShadowAlpha">1.0</item>
        <item name="android:spotShadowAlpha">1.0</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
