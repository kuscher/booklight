<?xml version="1.0" encoding="utf-8"?>
<!-- What Booklight has learned and its settings travel with the user's own backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="history.json" />
        <include domain="file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="history.json" />
        <include domain="file" path="settings.json" />
    </device-transfer>
</data-extraction-rules>
