<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dort abspielen: `play album discovery von daft punk auf spotify`. Eine Zeile, eine Aktion je Musik-App, benannt
         nach dem, was die App mit der Anfrage bekanntlich tut. Die Fußzeile sagt „Gesendet“, nie „Läuft“: es kommt nichts zurück. -->
    <string name="play_in">In %1$s abspielen</string>
    <string name="play_search_in">In %1$s suchen</string>
    <string name="play_no_app">Keine Musik-App auf diesem Gerät</string>
    <!-- The word before a player's name, as it is typed and as Booklight types it: "… on spotify". -->
    <string name="play_on">auf</string>
    <string name="play_sent">An %1$s gesendet</string>
    <!-- Unter dem Namen der Zeile: wie der Text gelesen wurde. %1$s ist der Interpret, wie getippt. -->
    <string name="play_song">Lied</string>
    <string name="play_song_by">Lied von %1$s</string>
    <string name="play_album">Album</string>
    <string name="play_album_by">Album von %1$s</string>
    <string name="play_artist">Interpret</string>
    <string name="play_playlist">Playlist</string>
    <string name="play_genre">Genre</string>
    <!-- `play` ohne Text: die Wiedergabetaste. -->
    <string name="play_resume">Fortsetzen</string>
    <string name="play_resume_sub">Was zuletzt lief</string>

    <!-- Die Medientasten nach dem getippten Wort: `pause` kann nur anhalten, `play` nur fortsetzen, `stopp` nur stoppen. Die Wörter finden auch die Zeile Medien. -->
    <string name="action_pause">Pause</string>
    <string name="action_stop">Stopp</string>
    <string name="dial_play_words">play,abspielen,wiedergabe,fortsetzen,resume</string>
    <string name="dial_pause_words">pause,pausieren,anhalten</string>
    <string name="dial_stop_words">stopp,stop,stoppen</string>

    <!-- Spotify spielt einen eigenen Link ab, und mit einem eigenen Schlüssel wird der Link zu einem Namen gefunden. Die Zeile
         von `play`, während Spotify gefragt wird, mit dem, was es gefunden hat, und mit dem Grund, wenn es nichts fand. -->
    <string name="play_looking">Wird nachgeschlagen</string>
    <string name="play_found_album">Album · %1$s</string>
    <string name="play_found_playlist">Playlist · %1$s</string>
    <string name="play_none">Spotify hat unter diesem Namen nichts gefunden</string>
    <string name="play_refused">Spotify hat den Schlüssel nicht angenommen</string>
    <string name="play_too_many">Gerade zu viele Abfragen bei Spotify</string>
    <string name="play_offline">Keine Verbindung</string>
    <string name="play_no_answer">Diesmal keine Antwort</string>
    <!-- Behind the row's arrow: the device's own model names the song a description or a misspelt name means; Enter on its answer puts it into the field. -->
    <string name="play_which">Welches Lied ist das?</string>
    <!-- In the footer, beside esc, while the model's answer stands over the text in the field: Escape goes back to the row it was asked from. -->
    <string name="hint_back">Zurück</string>
    <string name="play_use">Übernehmen</string>
    <string name="play_set_up">Spotify-Schlüssel eintragen</string>

    <!-- Booklight-Fenster › Labs: die Gruppe für den Spotify-Schlüssel -->
    <string name="set_songs">Spotify</string>
    <string name="set_song_key">Dein Spotify-Schlüssel</string>
    <string name="set_song_key_text">Mit Schlüssel zeigt „play …“, was Spotify gefunden hat, und Enter spielt es ab. Was du nach play tippst, und das Land deines Geräts, gehen an Spotify, sobald du kurz nicht tippst, und nur, solange Spotify in der Zeile gewählt ist. Der Schlüssel bleibt auf diesem Gerät und geht nur an Spotify.</string>
    <string name="set_song_id_hint">Client-ID</string>
    <string name="set_song_secret_hint">Client-Secret</string>
    <string name="set_song_key_in">Ein Schlüssel ist eingetragen</string>
    <string name="set_song_get">Schlüssel holen</string>
    <string name="set_song_get_text">developer.spotify.com: anmelden, eine App anlegen, Client ID und Client secret kopieren. Braucht Spotify Premium</string>
</resources>
