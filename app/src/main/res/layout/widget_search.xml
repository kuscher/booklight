<?xml version="1.0" encoding="utf-8"?>
<!-- The search pill: Booklight's mark and one word. The whole pill opens the panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="20dp"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_booklight"
        android:tint="@color/widget_ink" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_label"
        android:textColor="@color/widget_ink"
        android:textSize="16sp" />
</LinearLayout>
