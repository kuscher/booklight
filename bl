#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Booklight dev helper: build, install and drive the app on a Googlebook over adb.
#
#   ./bl build [release]     assemble the debug (or release) APK
#   ./bl test                core tests on this machine (JUnit, no device)
#   ./bl app                 build, install and open the panel
#   ./bl install [APK] | open [stay] [tint=N] [blur=DP] [dim=N] [shade=off|low|medium|high] | stop | uninstall
#                            `open stay` keeps the panel up when it loses focus (for pictures);
#                            DARK=true|false ./bl open stay shows it in that theme whatever the system's is;
#                            `open stay slow=4`: every spring four times as long (to step through a recording)
#   ./bl debug CMD...        test hooks (DebugReceiver.kt, debug builds): ping, apps, find TEXT, type TEXT,
#                            keys TEXT (one character at a time, as a person types: use this to test typing),
#                            key up|down|tab|esc|enter|enter2, dump, shot [NAME], close, forget,
#                            pill N (the next N frames in which the list's highlight travels, a line each
#                            in `./bl logs`: ms since it set off, its two edges as drawn, its row, in px),
#                            held down|up [TIMES] [MS] (the key as a held key repeats it),
#                            turn MS [enter] (close, and the key again MS later; with `enter`, Enter in that moment),
#                            pref flightkey KEY|none (the flight service's key; it is never printed),
#                            flight TEXT (a flight's row, looked up at once, without the panel),
#                            flight show NAME (a sample flight's row in the open panel, in the phase its
#                            name says: friday, soon, air, air-late, landed, landed-late, cancelled, diverted,
#                            timetable, looking, offline… or a saved reply, LH455-in-the-air; `flight show`
#                            lists them, `flight show off` ends it; the service is not asked),
#                            flight pin NAME (the same flight in the pinned window),
#                            appsearch (which lines of the bundled table and which declared searches the
#                            attached device takes: run it before a release)
#   ./bl shot [NAME] [OUT]   a PNG of the panel's own window (PixelCopy: no other apps; debug builds)
#   ./bl wshot [NAME] [OUT]  the same of the Booklight window
#   ./bl window [SECTION]    open the Booklight window, at a section if one is named (start, commands, look…);
#                            debug builds. `./bl debug window` says its size, its section and where the keys are;
#                            `./bl debug window close` closes it
#   ./bl screen [OUT]        the panel as it looks on screen, blur and shadow included: a crop of a
#                            screenshot around the panel's window (it shows what is behind the panel)
#   ./bl backdrop            a window of test content (white page, dark terminal, colour) to put behind
#                            the panel; debug builds. Captures over it show nobody's real windows
#   ./bl logs [N]            Booklight's log lines (the last 40, or N; every `./bl debug` and `./bl shot` clears the log first)
#   ./bl trace [all]         the frames the last `./bl debug first trace N` took, a line each: those in which something
#                            changed, or all of them. The app keeps them, so no hook that was run meanwhile loses them
#   ./bl sh CMD...           adb shell on the device
#   ./bl idle                seconds since the last user input on the device, and the focused window
#
# adb: $ADB, else `adb` on PATH, else the Mac's Android SDK. Device: $ANDROID_SERIAL, else the first
# attached device that isn't an emulator. Inside the Googlebook's own Linux VM, VSCodeBook's
# Unix-socket adb is used instead (never tcp:5037 there: the Terminal forwards every TCP port to Android).
# House rules: never touch the Debian VM (no Terminal launch or force-stop, no `vm`, no reboot), and
# check `./bl idle` before opening the panel: it takes the keyboard from whoever is typing.
# First run's stored state (core FirstRun; debug builds). It touches first run's own fields only, but for `key` and `answer agree`:
#   ./bl debug first                     shows it: the run, what is done, the screen that stands, its counter, the opening, the suggested key
#   ./bl debug first new|update|off | replay [show] | resume | key | helper | opened | shown | older
#   ./bl debug first answer not_now|go_on|change_key|skip|agree|done | ran open|search|sum | at k1|k2|k3|k4|l2|l3|l4|q|c
#   ./bl debug first welcome [at MS]     first run's welcome in the open panel; with `at`, standing still at that ms of the paper's clock
#   ./bl debug first show [at apps|row|stop|sum|answer|flight|grid|cell] | land     its show, or the show up to that moment and standing; the key's step set down
# While the piece plays, `./bl debug key enter|esc|tab|…` is taken by it first, as the keys are, and `dump` says `playing=`, `cast=`, `laps=`.
#   ./bl debug first again               as the window's "First steps" row writes it (then `./bl open stay` is the panel that row starts)
#   ./bl debug first stage at MS         the stage's clock stands at that ms after its screen came (a set-down as a still); `first stage` lets it run
#   ./bl debug first stage as whole|set_down|back|turn|after_list|lands [at MS]     the screen that stands comes again that way, now
#   ./bl debug first press [under] [held [TIMES] [MS]]     the user's key lands on the screen that waits for it: in view, or as under the
#                                        system's dialog, which is asked to go, as the real landing asks it; with `held`, TIMES more starts
#                                        by the key follow, MS apart, as a held key repeats: each starts the panel's own activity again
#   ./bl debug first says                what first run told a screen reader in this panel, and what every node of the panel says to one
#   ./bl debug first trace N             takes the next N frames (1 to 2400; 120 unless said): ms, the stage's clock, the window's height, `enter` and
#                                        `seen`, the key on the glass, laps, `hold=`. Read them with `./bl trace`: the app keeps them, the log does not
#   ./bl debug turn MS [enter]           the panel is closed and the key comes again MS later (60 unless said): "turned", or "not turned" where the
#                                        panel had already gone; with `enter`, Enter in the moment of the turn, and what it answered on the stage
#   ./bl debug pref sums on|off          "Show sums" (a run asked for again leaves the sum out where they are off)
# `dump` also says `comes=`, `lead=`, `all=`, `end=` and `enter` or `seen` for the stage that stands (how it came; when the armed answer
# begins to show and, where that is later, when every answer has; when it is at rest; `enter`: Enter on the armed answer counts, `seen`:
# every key and click does; `covered`: the screen came under the system's dialog and is still under it, and takes a key a third of a
# second after the dialog has gone), `later` (the bare field says where the steps wait), `keydown`, and `landing` (the user's key has
# just landed: for 0.7 s after its last start a start by the key does nothing).
# While a lesson stands (l2, l3, l4), `./bl debug key enter` on an app's row is practice, as the key is: nothing opens.
# `./bl debug in TEXT` types under the chip that is there (lesson 3's word); `key enter2` is Enter twice in one turn.
# `./bl debug dump` says `due=` (the screen that is due whatever the field holds), `coach=` (the footer's coach line),
# `pressed`, `choices` and `ended`; `./bl debug first` says `example=` (what the lessons' recipes show on this device).
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
PKG=io.github.kuscher.booklight
PANEL="$PKG/.overlay.OverlayActivity"
APK=app/build/outputs/apk/debug/app-debug.apk
ADB=${ADB:-$(command -v adb || echo "$HOME/Library/Android/sdk/platform-tools/adb")}
ENVF="$HOME/.config/vscodebook/android.env"
if [ -f "$ENVF" ]; then . "$ENVF"; export ADB_SERVER_SOCKET=${ADB_SERVER_SOCKET:-localfilesystem:$HOME/.local/state/vscodebook/adb.sock}; fi
TMP=${TMPDIR:-/tmp}; TMP=${TMP%/}

serial() {
  if [ -n "${ANDROID_SERIAL:-}" ]; then echo "$ANDROID_SERIAL"; return; fi
  "$ADB" devices | awk 'NR>1 && $2=="device" && $1 !~ /^emulator-/ {print $1; exit}'
}
A() { local s; s="$(serial)"; [ -n "$s" ] || { echo "bl: no device attached" >&2; exit 1; }; "$ADB" -s "$s" "$@"; }
user() { A shell am get-current-user | tr -d '\r'; }
dbg() {
  A logcat -c >/dev/null 2>&1 || true
  A shell "am broadcast --user current -a $PKG.DEBUG -p $PKG --es c '$*'" >/dev/null
  local first=${1:-}; local i
  for i in $(seq 1 "${TRIES:-20}"); do
    sleep 0.25
    local line; line=$(A shell "logcat -d -s Booklight:I" | grep "debug $first ->" | tail -1 || true)
    if [ -n "$line" ]; then echo "$line" | sed 's/.*-> //'; return; fi
  done
  echo "bl: no answer from the app (is it running?)" >&2; return 1
}
build() { if [ "${1:-}" = release ]; then ./gradlew :app:assembleRelease --console=plain -q; else ./gradlew :app:assembleDebug --console=plain -q; fi; }
install() {
  A shell settings put global verifier_verify_adb_installs 0
  A install -r "${1:-$APK}" || { A shell settings put global verifier_verify_adb_installs 1; exit 1; }
  A shell settings put global verifier_verify_adb_installs 1
}
open() { # open [stay] [tint=0.2] [blur=24] [dim=0.1] [slow=4]  (the glass values and the motion are for debug builds)
  local extra=() a
  for a in "$@"; do case "$a" in stay) extra+=(--ez stay true) ;; key) extra+=(--ez key true) ;; tint=*|blur=*|dim=*|slow=*) extra+=(--ef "${a%%=*}" "${a#*=}") ;; opening=*|shade=*) extra+=(--es "${a%%=*}" "${a#*=}") ;; esac; done
  A shell am start --user current -n "$PANEL" ${extra[@]+"${extra[@]}"} ${DARK:+--ez dark "$DARK"} >/dev/null
}

cmd=${1:-help}; shift || true
case "$cmd" in
  build) build "${1:-}" ;;
  test) ./gradlew :core:test --console=plain -q ;;
  install) install "${1:-}" ;;
  open) open "$@" ;;
  stop) A shell am force-stop --user current "$PKG" ;;
  probe) A logcat -c >/dev/null 2>&1 || true; A shell "am broadcast --user current -a $PKG.PROBE -p $PKG --es c '$1'" >/dev/null; sleep 1.2; A shell "logcat -d -s Booklight:I" | grep "probe $1 ->" | tail -1 | sed 's/.*-> //' | tr '|' '\n' ;;   # debug builds: what a plain app may do here (files, state)
  window) A shell am start --user current -n "$PKG/.window.MainActivity" ${1:+--es page "$1"} >/dev/null ;;   # debug builds: the Booklight window, at a section
  backdrop) A shell am start --user current -n "$PKG/.debug.BackdropActivity" >/dev/null ;;   # debug builds: test content to judge the glass against
  uninstall) A uninstall "$PKG" || true ;;   # every Android user (apps live in user 0 and 10)
  app) build && install && open stay ;;
  debug) dbg "$@" ;;
  shot)
    name=${1:-shot}; out=${2:-$TMP/booklight-$name.png}
    path=$(dbg shot "$name"); case "$path" in /*) ;; *) echo "bl: $path" >&2; exit 1 ;; esac
    A exec-out run-as "$PKG" --user "$(user)" cat "cache/$name.png" > "$out" && echo "$out" ;;
  wshot)   # a PNG of the Booklight window's own content (debug builds)
    name=${1:-window}; out=${2:-$TMP/booklight-$name.png}
    path=$(dbg wshot "$name"); case "$path" in /*) ;; *) echo "bl: $path" >&2; exit 1 ;; esac
    A exec-out run-as "$PKG" --user "$(user)" cat "cache/$name.png" > "$out" && echo "$out" ;;
  screen)
    out=${1:-$TMP/booklight-screen.png}
    read -r w h x y < <(dbg dump | sed -n 's/.*window=\([0-9]*\)x\([0-9]*\)@\(-\{0,1\}[0-9]*\),\(-\{0,1\}[0-9]*\).*/\1 \2 \3 \4/p')
    [ -n "${w:-}" ] || { echo "bl: no panel open" >&2; exit 1; }
    A exec-out screencap -p > "$out.full"
    m=${MARGIN:-60}
    python3 -c "import sys; from PIL import Image; w,h,x,y,m=map(int,sys.argv[3:8]); im=Image.open(sys.argv[1]); im.crop((max(0,x-m),max(0,y-m),min(im.width,x+w+m),min(im.height,y+h+m))).save(sys.argv[2])" "$out.full" "$out" "$w" "$h" "$x" "$y" "$m"
    rm -f "$out.full"; echo "$out" ;;
  logs) A shell "logcat -d -s Booklight:V AndroidRuntime:E" | tail -n "${1:-40}" ;;
  trace)   # the frames of the last `./bl debug first trace N`, asked of the app a page at a time (debug builds); `all`: every frame
    said=$(dbg first trace show ${1:+"$1"}); echo "$said" >&2
    pages=$(echo "$said" | sed -n 's/.* in \([0-9][0-9]*\) pages.*/\1/p'); p=1
    while [ "$p" -le "${pages:-0}" ]; do dbg first trace show ${1:+"$1"} "$p" | sed 's/^page [0-9]*\/[0-9]*: //' | tr ';' '\n'; p=$((p + 1)); done ;;
  sh) A shell "$@" ;;
  idle)
    A shell dumpsys power | grep -E "lastUserActivityTime=|mWakefulness=" | head -2
    A shell "dumpsys window | grep -E 'mCurrentFocus' | head -1" ;;
  *) awk 'NR >= 3 { if ($0 !~ /^#/) exit; print }' "$0" ;;   # the header, all of it: from line 3 to the first line that is no comment
esac
